# Kalurahan Margomulyo — environment template
#
# Copy to .env and fill in. .env is gitignored and must never be committed.
# Values below are placeholders, not real credentials.
#
# Supabase dashboard -> Project Settings -> API / Database

# --- Supabase project -------------------------------------------------------

# Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR-ANON-KEY"

# SERVER ONLY. Bypasses Row Level Security entirely.
# Never prefix with NEXT_PUBLIC_, never log, never send to the client.
SUPABASE_SERVICE_ROLE_KEY="YOUR-SERVICE-ROLE-KEY"

# --- Database ---------------------------------------------------------------

# Pooled connection (PgBouncer, port 6543) — used by the application at runtime.
DATABASE_URL="postgresql://postgres.YOUR-PROJECT-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct connection (port 5432) — used by Prisma for migrations only.
DIRECT_URL="postgresql://postgres.YOUR-PROJECT-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# --- Storage ----------------------------------------------------------------

# Public bucket: official documents, news images, project photography.
SUPABASE_BUCKET_PUBLIC="public"

# Private bucket: complaint and aspiration attachments.
# Must NOT be publicly readable. Served only via signed URLs from an
# authorized server route. See docs/adr/0002-database-auth-storage.md
SUPABASE_BUCKET_PRIVATE="private"

# --- Application ------------------------------------------------------------

# Canonical origin. Used for canonical URLs, Open Graph, sitemap and auth
# redirects. No trailing slash.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Secret for signing public complaint tracking tokens.
# Generate with:  openssl rand -base64 32
COMPLAINT_TOKEN_SECRET="GENERATE-A-32-BYTE-RANDOM-VALUE"
