{
  "name": "margomulyo",
  "version": "0.1.0",
  "private": true,
  "description": "Platform digital Kalurahan Margomulyo, Kapanewon Seyegan, Kabupaten Sleman, D.I. Yogyakarta",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "node scripts/with-env.mjs prisma generate",
    "db:validate": "node scripts/with-env.mjs prisma validate",
    "db:migrate": "node scripts/with-env.mjs prisma migrate deploy",
    "db:migrate:dev": "node scripts/with-env.mjs prisma migrate dev",
    "db:seed": "node scripts/with-env.mjs prisma db seed",
    "db:studio": "node scripts/with-env.mjs prisma studio",
    "postinstall": "prisma generate",
    "gates": "npm run lint && npm run typecheck && npm run test && npm run build",
    "db:status": "node scripts/with-env.mjs prisma migrate status"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "next": "^15.5.25",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "prisma": "^6.19.3",
    "tsx": "^4.23.13",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^15.5.25",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
