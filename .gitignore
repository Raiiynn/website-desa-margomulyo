# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# Environment — never commit real credentials
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Supabase
.supabase/

# Testing
coverage/
playwright-report/
test-results/
.nyc_output/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Claude Code — local, per-machine permission grants.
# .claude/settings.json (shared project config) IS tracked; this one is not.
.claude/settings.local.json

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Source material — large binaries, regenerable / archived externally.
# CHECKSUMS.txt and extracted-text.txt ARE committed as the audit trail.
docs/source/*.pdf
docs/source/*.png
docs/source/renders/
!docs/source/CHECKSUMS.txt
!docs/source/extracted-text.txt

# Scratch
*.local
